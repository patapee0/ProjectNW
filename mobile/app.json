{
  "expo": {
    "name": "KKU Dating",
    "slug": "kku-dating",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.kkudating.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#8B0000"
      },
      "package": "com.kkudating.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-status-bar",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow KKU Dating to access your microphone for voice messages.",
          "recordAudioAndroid": true,
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      "expo-asset"
    ]
  }
}
